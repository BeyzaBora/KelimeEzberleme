@model ErrorViewModel

<h1 class="text-danger">Error</h1>

@if (Model != null)
{
    <p>An error occurred while processing your request.</p>
    <p>Request ID: @Model.RequestId</p>

    @if (Model.ShowRequestId)
    {
        <p>Request ID: @Model.RequestId</p>
    }
}
else
{
    <p>No error details are available.</p>
}
