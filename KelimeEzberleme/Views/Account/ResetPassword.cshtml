@model KelimeEzberleme.ViewModels.ResetPasswordViewModel


@{
    ViewData["Title"] = "Şifre Sıfırlama";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Şifre Sıfırlama</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background: url('/images/arkaplan.jpg') no-repeat center center fixed;
            background-size: cover;
            font-family: 'Segoe UI', sans-serif;
            background-blend-mode: multiply;
        }

        .reset-container {
            width: 400px;
            margin: 100px auto;
            padding: 30px;
            border-radius: 20px;
            background: rgba(255, 165, 0, 0.7);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: #fff;
            text-align: center;
        }

        input[type="password"] {
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.4);
            background-color: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(4px);
            color: #000;
            font-size: 14px;
        }

        .reset-btn {
            width: 100%;
            background-color: darkorange;
            color: white;
            padding: 12px;
            font-size: 16px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            margin-top: 10px;
            transition: background-color 0.3s ease;
        }

            .reset-btn:hover {
                background-color: orangered;
            }

        .back-login-link {
            display: block;
            margin-top: 20px;
            font-size: 13px;
            color: white;
            text-decoration: none;
        }

            .back-login-link:hover {
                text-decoration: underline;
            }

        .validation-message {
            margin-top: 10px;
            color: #ffb3b3;
            font-size: 14px;
            text-align: left;
        }
    </style>
</head>
<body>
    <div class="reset-container">
        <h2>Yeni Şifre Belirle</h2>
        <form asp-action="ResetPassword" method="post">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <input asp-for="NewPassword" type="password" placeholder="Yeni Şifre" required />

            <input asp-for="ConfirmPassword" type="password" placeholder="Yeni Şifre (Tekrar)" required />

            <button type="submit" class="reset-btn">Şifreyi Güncelle</button>
        </form>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-message">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
            </div>
        }

        <a href="/Account/Login" class="back-login-link">Giriş Sayfasına Dön</a>
    </div>
</body>
</html>
