@{
    ViewData["Title"] = "Şifre Sıfırlama Onayı";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background: url('/images/arkaplan.jpg') no-repeat center center fixed;
            background-size: cover;
            font-family: 'Segoe UI', sans-serif;
            background-blend-mode: multiply;
            color: white;
        }

        .confirmation-container {
            width: 450px;
            margin: 150px auto;
            padding: 40px 30px;
            border-radius: 20px;
            background: rgba(255, 165, 0, 0.85);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            text-align: center;
        }

        h2 {
            margin-bottom: 25px;
            font-weight: 700;
            font-size: 28px;
        }

        p {
            font-size: 16px;
            line-height: 1.5;
            margin-bottom: 30px;
            color: #fff;
        }

        a.back-login-link {
            display: inline-block;
            padding: 12px 30px;
            background-color: darkorange;
            color: white;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 600;
            font-size: 16px;
            transition: background-color 0.3s ease;
        }

            a.back-login-link:hover {
                background-color: orangered;
            }
    </style>
</head>
<body>
    <div class="confirmation-container">
        <h2>Şifre Sıfırlama Linki Gönderildi</h2>
        <p>Eğer kayıtlı bir e-posta adresi girdinizse, şifre sıfırlama linki e-posta kutunuza gönderilmiştir.</p>
        <a href="/Account/Login" class="back-login-link">Giriş Sayfasına Dön</a>
    </div>
</body>
</html>
