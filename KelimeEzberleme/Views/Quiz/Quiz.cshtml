@model KelimeEzberleme.Models.InteractiveQuizViewModel
@{
    Layout = "_Layout";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelime Ezberleme - Quiz</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #FF8C00;
            margin: 0;
            padding: 0;
            text-align: center;
        }

        .quiz-container {
            background-color: rgba(255, 255, 255, 0.9);
            padding: 30px;
            border-radius: 10px;
            width: 80%;
            max-width: 600px;
            box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
            /* Ortalamayı sadece bu kutuya uygula */
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        h2 {
            color: #333;
            font-size: 2rem;
            margin-bottom: 20px;
        }

        .question-container {
            margin: 20px 0;
            width: 100%;
        }

        .left-aligned {
            text-align: left;
            font-size: 1.2rem;
            color: #333;
            padding-left: 20px;
        }

        input[type="text"] {
            width: 100%;
            padding: 10px;
            margin-top: 10px;
            border-radius: 5px;
            border: 1px solid #ccc;
            font-size: 1rem;
        }

        button {
            padding: 10px 20px;
            background-color: #28a745;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 20px;
            font-size: 1rem;
        }

            button:hover {
                background-color: #218838;
            }

        .answer-container {
            margin-top: 20px;
            text-align: left;
            color: #333;
        }

            .answer-container ul {
                list-style-type: none;
                padding-left: 0;
            }

            .answer-container li {
                margin-bottom: 10px;
                font-size: 1rem;
            }
    </style>
</head>
<body>
    <div class="quiz-container">
        <div class="header-container">
            <h2>Kelime Ezberleme</h2>
        </div>

        <div class="question-container">
            <h2>@Model.EngWordName</h2>
            <img src="@Model.Picture" alt="Word Image" style="max-width: 100%; height: auto;">

            <div class="left-aligned">
                <h3>Örnek Cümleler:</h3>
                <ul>
                    @foreach (var sample in Model.Samples)
                    {
                        <li>@sample.Samples</li>
                    }
                </ul>
            </div>

            <form method="post" asp-action="SubmitAnswer">
                <input type="hidden" name="WordID" value="@Model.WordID" />
                <input type="text" name="userAnswer" placeholder="Türkçe karşılığını girin" required />
                <button type="submit">Cevapla</button>
            </form>
        </div>

        <div class="answer-container">
            <p>Doğru Sayısı: @Model.CorrectCount | Yanlış Sayısı: @Model.IncorrectCount</p>
        </div>
    </div>
</body>
</html>
