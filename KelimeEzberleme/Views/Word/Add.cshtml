@model KelimeEzberleme.ViewModels.WordAddViewModel

@{
    ViewData["Title"] = "Kelime Ekle";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Kelime Ekle</title>
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background: #f39c12;
            padding: 50px;
        }

        .form-box {
            width: 500px;
            margin: auto;
            background-color: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
        }

            .form-box h2 {
                margin-bottom: 20px;
                color: #333;
            }

        input[type="text"], input[type="file"], select {
            width: 100%;
            padding: 10px;
            margin: 8px 0;
            border: 1px solid #ccc;
            border-radius: 6px;
        }

        .btn {
            padding: 10px 15px;
            background-color: orange;
            border: none;
            color: white;
            border-radius: 6px;
            cursor: pointer;
        }

            .btn:hover {
                background-color: darkorange;
            }

        .success-message {
            background-color: #d4edda;
            color: #155724;
            padding: 10px;
            border-radius: 6px;
            margin-bottom: 15px;
            text-align: center;
        }

        .error-message {
            background-color: #f8d7da;
            color: #721c24;
            padding: 10px;
            border-radius: 6px;
            margin-bottom: 15px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="form-box">
        <h2>Yeni Kelime Ekle</h2>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="success-message">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["Debug"] != null)
        {
            <div class="error-message">
                @TempData["Debug"]
            </div>
        }

        @Html.ValidationSummary(true, "", new { @class = "error-message" })

        @using (Html.BeginForm("Add", "Word", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <input asp-for="EngWordName" placeholder="İngilizce Kelime" required />
            <input asp-for="TurWordName" placeholder="Türkçe Karşılığı" required />

            <label>Resim Yükle:</label>
            <input asp-for="Image" type="file" accept="image/*" />

            <div id="samples">
                <label>Örnek Cümleler (En az 2):</label>
                <input name="Samples[0]" type="text" placeholder="Örnek cümle 1" required />
                <input name="Samples[1]" type="text" placeholder="Örnek cümle 2" required />

            </div>

            <button type="button" class="btn" onclick="addSample()">+ Cümle Ekle</button>

            <br />

            <br />

            <!-- Kategori Seçimi -->
            <label>Kategori Seçin:</label>
            <select asp-for="SelectedCategoryID" asp-items="Model.CategoryList" required>
                <option value="">-- Seçiniz --</option>
            </select>


            <br />
            <button type="submit" class="btn">Kaydet</button>
        }

        <br />
        <a href="@Url.Action("Index", "Dashboard")" class="btn" style="background-color: gray;">🏠 Ana Sayfaya Dön</a>
    </div>

    <script>
        let sampleCount = 2; // ilk 2 input var zaten

        function addSample() {
            const input = document.createElement("input");
            input.type = "text";
            input.name = `Samples[${sampleCount}]`;
            input.placeholder = "Yeni örnek cümle";
            input.style.marginTop = "5px";
            document.getElementById("samples").appendChild(input);
            sampleCount++;
        }
    </script>
</body>
</html>
